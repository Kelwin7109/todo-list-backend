# Copie este arquivo para .env. O .env NUNCA vai para o git.

# --- Banco de dados ---
# Escolha UM caminho: deixe uma linha DATABASE_URL ativa e a outra comentada (com #).


# Caminho 1 - SQLite: um arquivo local (todo_list.db), criado sozinho na primeira
# execução. Não precisa instalar nem configurar nada. Bom para começar.
DATABASE_URL=sqlite:///./todo_list.db

# --- Autenticacao (JWT) ---
# Segredo que assina os tokens: minimo 32 caracteres, diferente em cada instalacao.
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=troque_por_um_segredo_gerado_com_32_caracteres
# Quantos minutos um login continua valido.
JWT_EXPIRA_MINUTOS=120


# Caminho 2 - PostgreSQL no Render: cole a "External Database URL"
# (Render > seu banco > Connections) com DUAS mudanças:
#   1. troque o início "postgresql://" por "postgresql+psycopg://"
#   2. acrescente "?sslmode=require" no fim
# DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@HOST.oregon-postgres.render.com/BANCO?sslmode=require
